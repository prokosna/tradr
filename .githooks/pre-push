#!/bin/sh
# Refuses pushes to main, then runs the slow gates once per push rather than per commit.
set -u

while read -r _local_ref _local_sha remote_ref _remote_sha; do
	if [ "$remote_ref" = "refs/heads/main" ]; then
		echo "pre-push: refusing to push directly to main" >&2
		exit 1
	fi
done

ROOT_DIR=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT_DIR" || exit 1

run_stage() {
	stage_name="$1"
	shift
	if ! "$@"; then
		echo "pre-push: FAILED at stage: $stage_name" >&2
		exit 1
	fi
}

run_stage "cargo clippy" cargo clippy --workspace --all-targets -- -D warnings
run_stage "ci/windows-target.sh" sh ci/windows-target.sh
run_stage "cargo test" cargo test --workspace
if rustup target list --installed 2>/dev/null | grep -qx aarch64-linux-android; then
	run_stage "cargo check (android)" cargo check --target aarch64-linux-android -p tauri-plugin-tradr
fi

exit 0
