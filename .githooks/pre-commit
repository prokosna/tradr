#!/bin/sh
# DCR-036 local gate: runs full check suite on staged commits.
# See .githooks/README.md for details and activation instructions.
set -u

ROOT_DIR=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT_DIR" || exit 1

if git diff --cached --quiet; then
	exit 0
fi

# CLAUDE.md section 5: never commit directly to main. A detached HEAD
# reports "HEAD" here, not "main", so it is not refused.
current_branch=$(git rev-parse --abbrev-ref HEAD 2> /dev/null)
if [ "$current_branch" = "main" ]; then
	echo "pre-commit: refusing to commit directly to main" >&2
	exit 1
fi

run_stage() {
	stage_name="$1"
	shift
	if ! "$@"; then
		echo "pre-commit: FAILED at stage: $stage_name" >&2
		exit 1
	fi
}

run_stage "ci/run-all.sh" sh ci/run-all.sh
run_stage "cargo fmt --check" cargo fmt --check
run_stage "cargo clippy --workspace --all-targets -- -D warnings" cargo clippy --workspace --all-targets -- -D warnings
run_stage "cargo test --workspace" cargo test --workspace

exit 0
