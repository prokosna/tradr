{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "tradr",
	"version": "0.1.0",
	"identifier": "com.tradr.app",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:1420",
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build"
	},
	"app": {
		"windows": [
			{
				"title": "Tradr",
				"width": 800,
				"height": 600,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"android": {
			"debugApplicationIdSuffix": ".debug"
		}
	},
	"plugins": {
		"updater": {
			"endpoints": [
				"https://releases.tradr.example.com/v1/update/{{target}}/{{current_version}}"
			],
			"pubkey": "dW5zZXRfcHVia2V5X3BsYWNlaG9sZGVy"
		}
	}
}
