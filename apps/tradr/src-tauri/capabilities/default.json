{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "enables the default permissions",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"tradr:allow-device-identity",
		"tradr:allow-sign-in",
		"tradr:allow-sign-in-status",
		"tradr:allow-attestation-bundle",
		"tradr:allow-verify-peer-attestation",
		"tradr:allow-get-peers",
		"tradr:allow-get-visible-shares",
		"tradr:allow-list-peer-directory",
		"tradr:allow-download-file",
		"tradr:allow-send-files",
		"tradr:allow-add-static-peer",
		"tradr:allow-remove-static-peer",
		"tradr:allow-list-static-peers",
		"tradr:allow-publish-sharing-shortcuts",
		"tradr:allow-pick-share-root",
		"tradr:allow-request-permissions",
		"tradr:allow-check-permissions",
		"tradr:allow-show-incoming-transfer-notification",
		"tradr:allow-open-link-invite",
		"tradr:allow-reply-to-link-invite",
		"tradr:allow-approve-link",
		"tradr:allow-decline-link",
		"tradr:allow-preview-link-invite",
		"tradr:allow-pending-link-proposal",
		"tradr:allow-list-links",
		"tradr:allow-remove-link",
		"dialog:allow-open"
	]
}
