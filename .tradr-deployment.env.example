# Template for .tradr-deployment.env, gitignored at the repository root.
# Every build reads this file when the matching environment variable is
# unset (DCR-030). See README.md "Setting it up" for how to register a
# Google Cloud project and obtain these values.

TRADR_OAUTH_CLIENT_IDS=desktop:your-desktop-client-id.apps.googleusercontent.com,android:your-android-client-id.apps.googleusercontent.com
TRADR_OAUTH_CLIENT_SECRET=your-desktop-client-secret
